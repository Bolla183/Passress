# Copy this file to .env and adjust as needed.
# The suite reads these via process.env (loaded by playwright.config.ts).

# Storefront base URL (no trailing slash).
BASE_URL=https://www.passress.com

# Unpublished/preview theme id from the URL you were given, e.g.
# https://www.passress.com?preview_theme_id=189593944428
# Leave empty to test the LIVE published theme instead of a preview.
PREVIEW_THEME_ID=189593944428

# Optional: password if the storefront has Shopify's storefront password
# protection enabled (Online Store > Preferences). Leave empty otherwise.
STOREFRONT_PASSWORD=
