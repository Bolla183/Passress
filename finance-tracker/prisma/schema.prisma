generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Company (multi-tenant ready) ─────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  accounts           Account[]
  journalEntries     JournalEntry[]
  employees          Employee[]
  suppliers          Supplier[]
  customers          Customer[]
  products           Product[]
  productCategories  ProductCategory[]
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  bankAccounts       BankAccount[]
  loans              Loan[]
  fixedAssets        FixedAsset[]
  paymentMethods     PaymentMethod[]
  costCenters        CostCenter[]
  departments        Department[]
  collections        Collection[]
  brands             Brand[]
  warehouses         Warehouse[]
  locations          Location[]
  campaigns          Campaign[]
  projects           Project[]
  budgets            Budget[]
  taxRates           TaxRate[]
}

// ───────────────────────── Legacy (kept for migration/audit) ─────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  MANUAL
  SHOPIFY
}

model Transaction {
  id             String            @id @default(cuid())
  date           DateTime
  type           TransactionType
  category       String
  amount         Decimal           @db.Decimal(12, 2)
  note           String?
  source         TransactionSource @default(MANUAL)
  shopifyOrderId String?           @unique
  createdAt      DateTime          @default(now())

  @@index([date])
  @@index([type])
  @@index([category])
}

// ───────────────────────── Chart of Accounts ─────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

model Account {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  code          String
  name          String
  type          AccountType
  subtype       String?
  normalBalance NormalBalance
  parentId      String?
  parent        Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children      Account[]     @relation("AccountHierarchy")
  isActive      Boolean       @default(true)
  createdBy     String?
  createdAt     DateTime      @default(now())
  updatedBy     String?
  updatedAt     DateTime      @updatedAt

  journalLines JournalLine[]
  products     Product[]
  bankAccounts BankAccount[]
  loans        Loan[]
  fixedAssets  FixedAsset[]
  budgets      Budget[]

  @@unique([companyId, code])
  @@index([companyId, type])
  @@index([companyId, parentId])
}

// ───────────────────────── Ledger engine ─────────────────────────

enum JournalSource {
  MANUAL
  SHOPIFY
  SYSTEM
  MIGRATION
}

model JournalEntry {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  date            DateTime
  memo            String?
  source          JournalSource  @default(MANUAL)
  reference       String?
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  referenceNumber String?
  createdBy       String?
  createdAt       DateTime       @default(now())

  lines JournalLine[]

  @@index([companyId, date])
  @@index([companyId, source])
  @@index([reference])
}

model JournalLine {
  id             String       @id @default(cuid())
  companyId      String
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0) @db.Decimal(14, 2)
  credit         Decimal      @default(0) @db.Decimal(14, 2)
  memo           String?

  // Dimensions — all optional, enable "profit by X" reporting without touching the ledger model
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])
  employeeId   String?
  employee     Employee?   @relation(fields: [employeeId], references: [id])
  supplierId   String?
  supplier     Supplier?   @relation(fields: [supplierId], references: [id])
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id])
  productId    String?
  product      Product?    @relation(fields: [productId], references: [id])
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id])
  brandId      String?
  brand        Brand?      @relation(fields: [brandId], references: [id])
  campaignId   String?
  campaign     Campaign?   @relation(fields: [campaignId], references: [id])
  projectId    String?
  project      Project?    @relation(fields: [projectId], references: [id])
  warehouseId  String?
  warehouse    Warehouse?  @relation(fields: [warehouseId], references: [id])
  locationId   String?
  location     Location?   @relation(fields: [locationId], references: [id])

  @@index([companyId, accountId])
  @@index([journalEntryId])
  @@index([departmentId])
  @@index([costCenterId])
  @@index([employeeId])
  @@index([supplierId])
  @@index([customerId])
  @@index([productId])
  @@index([collectionId])
  @@index([brandId])
  @@index([campaignId])
  @@index([projectId])
  @@index([warehouseId])
  @@index([locationId])
}

// ───────────────────────── Master data ─────────────────────────

model Employee {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id])
  name         String
  email        String?
  phone        String?
  role         String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  salaryAmount Decimal?    @db.Decimal(14, 2)
  hireDate     DateTime?
  isActive     Boolean     @default(true)
  createdBy    String?
  createdAt    DateTime    @default(now())
  updatedBy    String?
  updatedAt    DateTime    @updatedAt

  journalLines JournalLine[]

  @@index([companyId, isActive])
  @@index([companyId, name])
}

model Supplier {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  isActive    Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  journalLines       JournalLine[]
  fixedAssets        FixedAsset[]
  inventoryMovements InventoryMovement[]

  @@index([companyId, isActive])
  @@index([companyId, name])
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  journalLines JournalLine[]

  @@index([companyId, isActive])
  @@index([companyId, name])
}

enum ProductType {
  RAW_MATERIAL
  FINISHED_GOOD
}

model ProductCategory {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([companyId, isActive])
}

model Product {
  id                 String           @id @default(cuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  sku                String
  name               String
  type               ProductType      @default(FINISHED_GOOD)
  cost               Decimal          @default(0) @db.Decimal(14, 2)
  price              Decimal          @default(0) @db.Decimal(14, 2)
  productCategoryId  String?
  productCategory    ProductCategory? @relation(fields: [productCategoryId], references: [id])
  brandId            String?
  brand              Brand?           @relation(fields: [brandId], references: [id])
  collectionId       String?
  collection         Collection?      @relation(fields: [collectionId], references: [id])
  inventoryAccountId String?
  inventoryAccount   Account?         @relation(fields: [inventoryAccountId], references: [id])
  isActive           Boolean          @default(true)
  createdBy          String?
  createdAt          DateTime         @default(now())
  updatedBy          String?
  updatedAt          DateTime         @updatedAt

  journalLines       JournalLine[]
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]

  @@unique([companyId, sku])
  @@index([companyId, isActive])
}

model InventoryItem {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  quantityOnHand Decimal   @default(0) @db.Decimal(14, 4)
  updatedAt      DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@index([companyId])
}

enum InventoryMovementType {
  PURCHASE
  SALE
  TRANSFORM
  ADJUSTMENT
}

model InventoryMovement {
  id             String                @id @default(cuid())
  companyId      String
  company        Company               @relation(fields: [companyId], references: [id])
  productId      String
  product        Product               @relation(fields: [productId], references: [id])
  warehouseId    String
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])
  supplierId     String?
  supplier       Supplier?             @relation(fields: [supplierId], references: [id])
  type           InventoryMovementType
  quantity       Decimal               @db.Decimal(14, 4)
  unitCost       Decimal               @db.Decimal(14, 2)
  journalEntryId String?
  date           DateTime
  memo           String?
  createdBy      String?
  createdAt      DateTime              @default(now())

  @@index([companyId, productId])
  @@index([companyId, date])
}

enum BankAccountType {
  CASH
  PETTY_CASH
  CURRENT_ACCOUNT
  SAVINGS_ACCOUNT
  CREDIT_CARD
  BUSINESS_LOAN
}

model BankAccount {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  name           String
  type           BankAccountType
  accountNumber  String?
  glAccountId    String
  glAccount      Account         @relation(fields: [glAccountId], references: [id])
  openingBalance Decimal         @default(0) @db.Decimal(14, 2)
  isActive       Boolean         @default(true)
  createdBy      String?
  createdAt      DateTime        @default(now())
  updatedBy      String?
  updatedAt      DateTime        @updatedAt

  @@index([companyId, isActive])
}

model Loan {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  lender       String
  principal    Decimal  @db.Decimal(14, 2)
  interestRate Decimal  @db.Decimal(6, 3)
  startDate    DateTime
  termMonths   Int
  glAccountId  String
  glAccount    Account  @relation(fields: [glAccountId], references: [id])
  isActive     Boolean  @default(true)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedBy    String?
  updatedAt    DateTime @updatedAt

  @@index([companyId, isActive])
}

enum DepreciationMethod {
  NONE
  STRAIGHT_LINE
  DECLINING_BALANCE
}

model FixedAsset {
  id                 String             @id @default(cuid())
  companyId          String
  company            Company            @relation(fields: [companyId], references: [id])
  name               String
  category           String?
  purchaseDate       DateTime
  purchaseCost       Decimal            @db.Decimal(14, 2)
  supplierId         String?
  supplier           Supplier?          @relation(fields: [supplierId], references: [id])
  serialNumber       String?
  locationId         String?
  location           Location?          @relation(fields: [locationId], references: [id])
  usefulLifeMonths   Int?
  residualValue      Decimal            @default(0) @db.Decimal(14, 2)
  depreciationMethod DepreciationMethod @default(NONE)
  currentBookValue   Decimal            @db.Decimal(14, 2)
  glAccountId        String?
  glAccount          Account?           @relation(fields: [glAccountId], references: [id])
  isActive           Boolean            @default(true)
  createdBy          String?
  createdAt          DateTime           @default(now())
  updatedBy          String?
  updatedAt          DateTime           @updatedAt

  @@index([companyId, isActive])
}

model PaymentMethod {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  journalEntries JournalEntry[]

  @@index([companyId, isActive])
}

model CostCenter {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  journalLines JournalLine[]
  budgets      Budget[]

  @@index([companyId, isActive])
}

model Department {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  employees    Employee[]
  journalLines JournalLine[]
  budgets      Budget[]

  @@index([companyId, isActive])
}

model Collection {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  products     Product[]
  journalLines JournalLine[]

  @@index([companyId, isActive])
}

model Brand {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  products     Product[]
  journalLines JournalLine[]

  @@index([companyId, isActive])
}

model Warehouse {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  journalLines       JournalLine[]

  @@index([companyId, isActive])
}

model Location {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  fixedAssets  FixedAsset[]
  journalLines JournalLine[]

  @@index([companyId, isActive])
}

model Campaign {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  journalLines JournalLine[]

  @@index([companyId, isActive])
}

model Project {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  journalLines JournalLine[]

  @@index([companyId, isActive])
}

enum BudgetPeriodType {
  MONTH
  QUARTER
  YEAR
}

model Budget {
  id           String           @id @default(cuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id])
  accountId    String
  account      Account          @relation(fields: [accountId], references: [id])
  departmentId String?
  department   Department?      @relation(fields: [departmentId], references: [id])
  costCenterId String?
  costCenter   CostCenter?      @relation(fields: [costCenterId], references: [id])
  periodType   BudgetPeriodType
  period       String
  amount       Decimal          @db.Decimal(14, 2)
  createdBy    String?
  createdAt    DateTime         @default(now())
  updatedBy    String?
  updatedAt    DateTime         @updatedAt

  @@index([companyId, accountId, period])
}

model TaxRate {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  ratePercent Decimal  @db.Decimal(6, 3)
  isActive    Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@index([companyId, isActive])
}
