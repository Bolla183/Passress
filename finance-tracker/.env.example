DATABASE_URL="postgresql://user:password@localhost:5432/passress_finance?schema=public"
APP_PASSWORD="change-me"
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional: enables the "Sync Shopify" button on the daily dashboard
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_..."

# Required for the Shopify sync cron and the daily digest email cron
CRON_SECRET="change-me"

# Optional: enables the daily digest email (Cash Available, this month's
# figures, Business Health, top insights) sent to partners on a schedule
RESEND_API_KEY="re_..."
DAILY_DIGEST_RECIPIENTS="partner1@example.com,partner2@example.com"
DAILY_DIGEST_FROM="Passress <onboarding@resend.dev>"
