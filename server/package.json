{
  "name": "passress-tryon-api",
  "version": "1.0.0",
  "private": true,
  "description": "Passress AI Virtual Try-On backend: job API, queue worker, storage and provider abstraction.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.660.0",
    "@aws-sdk/s3-request-presigner": "^3.660.0",
    "@prisma/client": "^5.19.1",
    "bullmq": "^5.13.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "file-type": "^22.0.1",
    "ioredis": "^5.4.1",
    "multer": "^2.2.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "sharp": "^0.33.5",
    "uuid": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.16.5",
    "@types/uuid": "^10.0.0",
    "pino-pretty": "^11.2.2",
    "prisma": "^5.19.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
