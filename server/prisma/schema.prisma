generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TryOnJobStatus {
  queued
  processing
  succeeded
  failed
}

model TryOnJob {
  id               String         @id @default(uuid())
  shopDomain       String
  productId        String
  variantId        String?
  productTitle     String
  colorName        String?
  garmentImageUrl  String?
  status           TryOnJobStatus @default(queued)
  provider         String?
  sourceImageKey   String
  resultImageKey   String?
  errorMessage     String?
  attempts         Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  expiresAt        DateTime

  @@index([shopDomain, createdAt])
  @@index([status])
  @@index([expiresAt])
}
