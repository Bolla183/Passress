# --- Server ---
PORT=8080
NODE_ENV=development

# Comma-separated list of storefront origins allowed to call this API.
# The Shopify theme is the only intended caller.
ALLOWED_SHOP_ORIGINS=https://passress.com,https://passress.myshopify.com

# --- Database (job metadata) ---
DATABASE_URL=postgresql://tryon:tryon@localhost:5432/tryon

# --- Queue ---
REDIS_URL=redis://localhost:6379

# --- Object storage (any S3-compatible provider: AWS S3, Cloudflare R2, DO Spaces) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=passress-tryon
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
# How long signed result URLs stay valid, in seconds.
STORAGE_SIGNED_URL_TTL_SECONDS=900

# --- Job lifecycle ---
# How long an uploaded photo + result stay in storage before automatic deletion.
JOB_TTL_HOURS=24
# Max upload size in bytes (default 8MB).
MAX_UPLOAD_BYTES=8388608

# --- AI provider swap point ---
# "mock" is the only provider implemented today. Adding a real provider means
# writing a new class in src/providers and adding one case to provider-factory.ts —
# nothing else in this codebase (routes, worker, job model, frontend contract) changes.
TRYON_PROVIDER=mock
# Example future values once implemented, e.g.:
# TRYON_PROVIDER=acme-vision
# ACME_VISION_API_KEY=
# ACME_VISION_BASE_URL=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MINUTES=10
RATE_LIMIT_MAX_JOBS_PER_WINDOW=10
