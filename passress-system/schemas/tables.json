{
  "version": "2.0.0",
  "notes": "Single source of truth for every table in the PASSRESS four-workbook system. Column order here = CSV column order = Excel table column order. kind: input = typed by the operator in Excel; output = produced by the PowerShell engine and loaded into Excel by Power Query (read-only for the operator). Types: text | number | int | date | datetime | bool.",
  "workbooks": {
    "01_DATA_SOURCE": {
      "file": "01_DATA_SOURCE\\01_DATA_SOURCE.xlsx",
      "folder": "01_DATA_SOURCE",
      "tables": [
        { "name": "ORDER_CLASSIFICATION", "kind": "input", "purpose": "Manual TEST/REAL classification per Shopify order. Orders not listed default to REAL.", "columns": [
          ["OrderGID", "text", "gid://shopify/Order/<id>. Preferred match key."],
          ["OrderName", "text", "e.g. #1008. Used only when OrderGID is blank."],
          ["Classification", "text", "TEST or REAL"],
          ["Reason", "text", "Why this classification was set"],
          ["EffectiveDate", "date", "Date the classification was decided"],
          ["UpdatedAt", "datetime", "Last edit timestamp"],
          ["UpdatedBy", "text", "Operator"]
        ]},
        { "name": "RAW_ORDERS", "kind": "output", "purpose": "One row per Shopify order, raw values.", "columns": [
          ["OrderGID", "text", "Shopify order GID"],
          ["OrderName", "text", "Order name e.g. #1008"],
          ["CreatedAtUtc", "datetime", "createdAt (UTC)"],
          ["ProcessedAtUtc", "datetime", "processedAt (UTC)"],
          ["UpdatedAtUtc", "datetime", "updatedAt (UTC)"],
          ["CancelledAtUtc", "datetime", "cancelledAt (UTC), blank if not cancelled"],
          ["CancelReason", "text", "cancelReason"],
          ["ShopifyTestFlag", "bool", "Shopify order.test"],
          ["FinancialStatus", "text", "displayFinancialStatus"],
          ["FulfillmentStatus", "text", "displayFulfillmentStatus"],
          ["Currency", "text", "Shop currency"],
          ["Subtotal", "number", "subtotalPriceSet"],
          ["Discounts", "number", "totalDiscountsSet"],
          ["Shipping", "number", "totalShippingPriceSet"],
          ["Taxes", "number", "totalTaxSet"],
          ["TotalPrice", "number", "totalPriceSet"],
          ["TotalReceived", "number", "totalReceivedSet"],
          ["TotalRefunded", "number", "totalRefundedSet"],
          ["NetPayment", "number", "netPaymentSet"],
          ["CustomerGID", "text", "Customer GID"],
          ["SourceName", "text", "Sales channel"],
          ["Tags", "text", "Comma-separated tags"],
          ["ExtractRunId", "text", "Refresh run that extracted the row"]
        ]},
        { "name": "ORDER_LINE_ITEMS", "kind": "output", "purpose": "One row per original order line item.", "columns": [
          ["LineItemGID", "text", "Shopify line item GID (primary key)"],
          ["OrderGID", "text", "Parent order"],
          ["OrderName", "text", "Order name"],
          ["ProductGID", "text", "Product GID"],
          ["VariantGID", "text", "Variant GID"],
          ["SKU", "text", "SKU (blank = missing SKU exception)"],
          ["ProductTitle", "text", "Product title"],
          ["VariantTitle", "text", "Variant title"],
          ["Quantity", "int", "Original quantity"],
          ["CurrentQuantity", "int", "Shopify currentQuantity"],
          ["UnitPrice", "number", "originalUnitPriceSet"],
          ["LineDiscount", "number", "Sum of discountAllocations"],
          ["GrossLineAmount", "number", "Quantity x UnitPrice"],
          ["NetLineAmount", "number", "Gross - discount"],
          ["LineTax", "number", "Sum of taxLines"],
          ["CreatedAtUtc", "datetime", "Order createdAt"]
        ]},
        { "name": "ORDER_TRANSACTIONS", "kind": "output", "purpose": "Every order transaction (sales, captures, refunds, voids) with status.", "columns": [
          ["TransactionGID", "text", "Transaction GID"],
          ["OrderGID", "text", "Order"],
          ["OrderName", "text", "Order name"],
          ["RefundGID", "text", "Refund this transaction belongs to (blank for sales)"],
          ["Kind", "text", "SALE / CAPTURE / AUTHORIZATION / REFUND / VOID / CHANGE"],
          ["Status", "text", "SUCCESS / PENDING / FAILURE / ERROR / AWAITING_RESPONSE / UNKNOWN"],
          ["Gateway", "text", "Payment gateway"],
          ["ProcessedAtUtc", "datetime", "processedAt"],
          ["ProcessedDateLocal", "date", "processedAt in shop time zone"],
          ["Amount", "number", "amountSet"],
          ["IsSuccessfulCollection", "bool", "SALE/CAPTURE with SUCCESS"],
          ["IsSuccessfulRefund", "bool", "REFUND with SUCCESS"]
        ]},
        { "name": "RAW_REFUNDS", "kind": "output", "purpose": "One row per Shopify refund record.", "columns": [
          ["RefundGID", "text", "Refund GID"],
          ["OrderGID", "text", "Order"],
          ["OrderName", "text", "Order name"],
          ["RefundCreatedAtUtc", "datetime", "Refund createdAt"],
          ["Note", "text", "Refund note"],
          ["TotalRefundedReported", "number", "Refund.totalRefundedSet as reported by Shopify"],
          ["SuccessfulTransactionTotal", "number", "Sum of SUCCESS REFUND transactions"],
          ["NonSuccessfulTransactionCount", "int", "Refund transactions not SUCCESS"],
          ["RecognitionDateLocal", "date", "Date of the successful refund transaction (shop time zone); blank if no money moved"],
          ["RecognitionMonth", "text", "yyyy-MM of RecognitionDateLocal"],
          ["Currency", "text", "Currency"]
        ]},
        { "name": "REFUND_LINE_ITEMS", "kind": "output", "purpose": "One row per refunded line item, linked to the ORIGINAL line item GID.", "columns": [
          ["RefundLineItemGID", "text", "Refund line item GID"],
          ["RefundGID", "text", "Parent refund"],
          ["OrderGID", "text", "Order"],
          ["LineItemGID", "text", "ORIGINAL order line item GID"],
          ["SKU", "text", "SKU of the original line"],
          ["Quantity", "int", "Refunded quantity"],
          ["Subtotal", "number", "subtotalSet"],
          ["Tax", "number", "totalTaxSet"],
          ["Total", "number", "Subtotal + Tax"],
          ["RestockType", "text", "Shopify restockType (information only - NOT proof of physical return)"],
          ["Restocked", "bool", "Shopify restocked flag (information only)"],
          ["LocationName", "text", "Restock location"]
        ]},
        { "name": "REFUND_TRANSACTIONS", "kind": "output", "purpose": "Refund transactions only (subset of ORDER_TRANSACTIONS) for the money-refund audit.", "columns": [
          ["TransactionGID", "text", "Transaction GID"],
          ["RefundGID", "text", "Refund"],
          ["OrderGID", "text", "Order"],
          ["Kind", "text", "REFUND"],
          ["Status", "text", "Status"],
          ["Gateway", "text", "Gateway"],
          ["ProcessedAtUtc", "datetime", "processedAt"],
          ["ProcessedDateLocal", "date", "Shop-local date"],
          ["Amount", "number", "Amount"],
          ["IsSuccessfulRefund", "bool", "Counts as money refunded"]
        ]},
        { "name": "RAW_CUSTOMERS", "kind": "output", "purpose": "Shopify customers (personal data - local only).", "columns": [
          ["CustomerGID", "text", "Customer GID"],
          ["DisplayName", "text", "Name"],
          ["Email", "text", "Email"],
          ["Phone", "text", "Phone"],
          ["CreatedAtUtc", "datetime", "createdAt"],
          ["NumberOfOrders", "int", "Shopify count (includes test orders)"],
          ["AmountSpent", "number", "Shopify amountSpent (NOT net revenue)"],
          ["City", "text", "Default address city"],
          ["Province", "text", "Default address province"],
          ["Country", "text", "Default address country"],
          ["MarketingConsent", "text", "Email marketing state"]
        ]},
        { "name": "RAW_PRODUCTS", "kind": "output", "purpose": "Shopify products.", "columns": [
          ["ProductGID", "text", "Product GID"],
          ["ProductTitle", "text", "Title"],
          ["ProductType", "text", "productType"],
          ["Vendor", "text", "vendor"],
          ["Status", "text", "ACTIVE / DRAFT / ARCHIVED"]
        ]},
        { "name": "RAW_VARIANTS", "kind": "output", "purpose": "Shopify variants with stock snapshot (used only as a reconciliation check).", "columns": [
          ["VariantGID", "text", "Variant GID"],
          ["ProductGID", "text", "Product GID"],
          ["SKU", "text", "SKU"],
          ["ProductTitle", "text", "Product title"],
          ["VariantTitle", "text", "Variant title"],
          ["OptionValues", "text", "name=value pairs"],
          ["Price", "number", "Selling price"],
          ["ShopifyUnitCost", "number", "inventoryItem.unitCost (information only - COST_MASTER is authoritative)"],
          ["ShopifyInventoryQty", "int", "inventoryQuantity snapshot"]
        ]},
        { "name": "SALES_FACT", "kind": "output", "purpose": "One row per ORIGINAL order line item with classification, quantities, allocated refunds and cancellations. No cost here (cost lives in 02).", "columns": [
          ["LineItemGID", "text", "Primary key"],
          ["OrderGID", "text", "Order"],
          ["OrderName", "text", "Order name"],
          ["CustomerGID", "text", "Customer"],
          ["OrderDateLocal", "date", "Order date in shop time zone (Africa/Cairo)"],
          ["OrderMonth", "text", "yyyy-MM"],
          ["SKU", "text", "SKU"],
          ["VariantGID", "text", "Variant"],
          ["ProductTitle", "text", "Product"],
          ["VariantTitle", "text", "Variant"],
          ["Classification", "text", "REAL / TEST / UNCLASSIFIED"],
          ["ClassificationSource", "text", "MANUAL / SHOPIFY_TEST_FLAG / TEST_TAG / DEFAULT / INVALID_ENTRY"],
          ["IsReportable", "bool", "TRUE only for REAL orders - every report filters on this"],
          ["OrderCancelled", "bool", "Order has cancelledAt"],
          ["QtyOrdered", "int", "Original quantity"],
          ["QtyCancelled", "int", "Quantity reversed by cancellation (no money)"],
          ["QtyCancelledUnshipped", "int", "Cancelled before shipping (restockType CANCEL) - never costed"],
          ["QtyShipped", "int", "QtyOrdered - QtyCancelledUnshipped = COGS quantity"],
          ["QtyRefunded", "int", "Quantity on money refunds (financial refund only)"],
          ["UnitPrice", "number", "Unit price"],
          ["GrossSales", "number", "QtyOrdered x UnitPrice"],
          ["LineDiscount", "number", "Allocated discounts"],
          ["NetSales", "number", "Gross - discount"],
          ["RefundAllocated", "number", "Money refunds allocated to this line by Shopify refund line items (excl. tax)"],
          ["CancellationReversal", "number", "Revenue reversed by cancellation"],
          ["NetRevenue", "number", "NetSales - RefundAllocated - CancellationReversal (excludes unallocated refunds, see REVENUE_EVENTS)"],
          ["FinancialStatus", "text", "Order-level status (display only, never used for allocation)"],
          ["FulfillmentStatus", "text", "Order-level fulfillment"],
          ["MissingSKU", "bool", "SKU blank"]
        ]},
        { "name": "REVENUE_EVENTS", "kind": "output", "purpose": "Revenue ledger: sales in the order month, refunds in the month the successful refund transaction occurred, cancellations in the cancel month.", "columns": [
          ["EventID", "text", "Deterministic unique ID (idempotent)"],
          ["EventType", "text", "SALE / SALE_SHIPPING / REFUND_LINE / REFUND_SHIPPING / REFUND_ADJUSTMENT / REFUND_UNALLOCATED / CANCELLATION"],
          ["OrderGID", "text", "Order"],
          ["OrderName", "text", "Order name"],
          ["LineItemGID", "text", "Original line (blank for order-level events)"],
          ["RefundGID", "text", "Refund (refund events)"],
          ["SKU", "text", "SKU"],
          ["EventDateLocal", "date", "Recognition date"],
          ["EventMonth", "text", "yyyy-MM"],
          ["Quantity", "int", "Quantity (signed)"],
          ["GrossAmount", "number", "Gross sales (SALE only)"],
          ["DiscountAmount", "number", "Discount (SALE only)"],
          ["TaxAmount", "number", "Tax (signed)"],
          ["NetAmount", "number", "Revenue effect, signed (+ sale / - refund, cancellation)"],
          ["Classification", "text", "REAL / TEST / UNCLASSIFIED"],
          ["IsReportable", "bool", "REAL only"]
        ]},
        { "name": "REFUND_RECONCILIATION", "kind": "output", "purpose": "Per refund: successful money vs Shopify line/shipping/adjustment allocations.", "columns": [
          ["RefundGID", "text", "Refund"],
          ["OrderGID", "text", "Order"],
          ["OrderName", "text", "Order name"],
          ["Classification", "text", "Order classification"],
          ["RecognitionMonth", "text", "Month the refund is recognised"],
          ["SuccessfulTransactionTotal", "number", "Money actually refunded"],
          ["TotalRefundedReported", "number", "Shopify reported total"],
          ["LineAllocatedTotal", "number", "Sum refund line Total (subtotal+tax)"],
          ["ShippingRefund", "number", "Refunded shipping"],
          ["Adjustments", "number", "Order adjustments"],
          ["Unallocated", "number", "Success total - allocations (never assigned to a product)"],
          ["RefundedQuantity", "int", "Sum of refund line quantities"],
          ["Status", "text", "ALLOCATED / UNALLOCATED / MISMATCH / QUANTITY_ONLY / NO_MONEY"]
        ]},
        { "name": "EXCEPTIONS", "kind": "output", "purpose": "Data Source exceptions. Never hidden.", "columns": [
          ["ExceptionID", "text", "Deterministic ID"],
          ["CheckName", "text", "Check"],
          ["Severity", "text", "ERROR / WARNING / INFO"],
          ["Status", "text", "OPEN"],
          ["AffectedRecord", "text", "Record key"],
          ["OrderName", "text", "Order name if relevant"],
          ["Classification", "text", "Order classification if relevant"],
          ["ExpectedValue", "text", "Expected"],
          ["ActualValue", "text", "Actual"],
          ["Difference", "number", "Numeric difference where applicable"],
          ["RecommendedAction", "text", "What to do"],
          ["RunId", "text", "Run"]
        ]},
        { "name": "LOG_REFRESH", "kind": "output", "purpose": "Refresh history for this workbook (append-only).", "columns": [
          ["RunId", "text", "Run"],
          ["Stage", "text", "01 / 02 / 03 / 04"],
          ["StartedAt", "datetime", "Start"],
          ["EndedAt", "datetime", "End"],
          ["Status", "text", "OK / FAILED"],
          ["Mode", "text", "LIVE / OFFLINE"],
          ["UpstreamRunId", "text", "Run id of the upstream stage consumed"],
          ["RowCounts", "text", "table=count;..."],
          ["ErrorCount", "int", "ERROR exceptions"],
          ["WarningCount", "int", "WARNING exceptions"],
          ["Message", "text", "Error text if failed"]
        ]}
      ]
    },
    "02_OPERATIONS": {
      "file": "02_OPERATIONS\\02_OPERATIONS.xlsx",
      "folder": "02_OPERATIONS",
      "tables": [
        { "name": "HEIRARCHY", "kind": "input", "purpose": "Product hierarchy and reorder levels per SKU.", "columns": [
          ["SKU", "text", "SKU"],
          ["ProductName", "text", "Product name"],
          ["ProductType", "text", "Blazer / Pants / Sleeves / ..."],
          ["Category", "text", "Category"],
          ["Subcategory", "text", "Subcategory"],
          ["Collection", "text", "Collection"],
          ["Season", "text", "Season"],
          ["ActiveStatus", "text", "ACTIVE / INACTIVE"],
          ["ReorderLevel", "int", "Reorder threshold (blank = not set)"]
        ]},
        { "name": "COST_MASTER", "kind": "input", "purpose": "APPEND-ONLY effective-dated unit costs. Never edit an approved row - add a new row with a new EffectiveFrom.", "columns": [
          ["CostRecordID", "text", "Unique ID e.g. COST-0001"],
          ["SKU", "text", "SKU"],
          ["VariantGID", "text", "Optional variant GID"],
          ["FabricCost", "number", "Fabric"],
          ["ManufacturingCost", "number", "Manufacturing"],
          ["AccessoriesCost", "number", "Accessories"],
          ["PackagingCost", "number", "Packaging"],
          ["OtherDirectCost", "number", "Other direct"],
          ["UnitCost", "number", "Total unit cost (must equal component sum when components are entered)"],
          ["Currency", "text", "EGP"],
          ["EffectiveFrom", "date", "First date the cost applies"],
          ["EffectiveTo", "date", "Last date (blank = open)"],
          ["Source", "text", "Where the number came from"],
          ["ApprovedBy", "text", "Required - unapproved rows are ignored"],
          ["CreatedAt", "datetime", "Entry timestamp"],
          ["Notes", "text", "Notes"]
        ]},
        { "name": "OPENING_INVENTORY", "kind": "input", "purpose": "Counted opening stock per SKU. Never assumed zero.", "columns": [
          ["SKU", "text", "SKU"],
          ["AsOfDate", "date", "Count date"],
          ["SellableQty", "int", "Sellable units"],
          ["DamagedQty", "int", "Damaged units"],
          ["UnitCost", "number", "Cost per unit used for the opening value"],
          ["CountedBy", "text", "Who counted"],
          ["Notes", "text", "Notes"]
        ]},
        { "name": "PRODUCTION", "kind": "input", "purpose": "Production runs. Completed + received quantity enters stock.", "columns": [
          ["ProductionID", "text", "e.g. PRD-0001"],
          ["ProductionDate", "date", "Start date"],
          ["Workshop", "text", "Supplier / workshop"],
          ["SKU", "text", "SKU"],
          ["QtyPlanned", "int", "Planned"],
          ["QtyCompleted", "int", "Completed and accepted"],
          ["QtyRejected", "int", "Rejected"],
          ["UnitProductionCost", "number", "Cost per unit (blank = use COST_MASTER)"],
          ["ReceivedDate", "date", "Date completed units entered stock"],
          ["Status", "text", "PLANNED / IN_PROGRESS / RECEIVED / CANCELLED"],
          ["Notes", "text", "Notes"]
        ]},
        { "name": "SUPPLIERS", "kind": "input", "purpose": "Supplier master.", "columns": [
          ["SupplierID", "text", "e.g. SUP-001"],
          ["SupplierName", "text", "Name"],
          ["SupplierType", "text", "FABRIC / WORKSHOP / PACKAGING / COURIER / OTHER"],
          ["Phone", "text", "Phone"],
          ["Notes", "text", "Notes"]
        ]},
        { "name": "PURCHASES", "kind": "input", "purpose": "Purchases of finished SKUs or materials. Payments are recorded in 03 DATA_ENTRY.", "columns": [
          ["PurchaseID", "text", "e.g. PUR-0001"],
          ["SupplierID", "text", "Supplier"],
          ["PurchaseDate", "date", "Order date"],
          ["ItemType", "text", "SKU or MATERIAL"],
          ["SKUOrMaterial", "text", "SKU (ItemType=SKU) or material name"],
          ["Description", "text", "Description"],
          ["Quantity", "number", "Ordered quantity"],
          ["UnitCost", "number", "Unit cost"],
          ["TotalCost", "number", "Quantity x UnitCost"],
          ["ExpectedDelivery", "date", "Expected"],
          ["ActualDelivery", "date", "Actual"],
          ["ReceivedQty", "number", "Quantity received"],
          ["Status", "text", "ORDERED / RECEIVED / PARTIAL / CANCELLED"],
          ["Notes", "text", "Notes"]
        ]},
        { "name": "RETURNS", "kind": "input", "purpose": "PHYSICAL returns. A refund does not create a row here - only goods actually coming back do.", "columns": [
          ["ReturnID", "text", "e.g. RET-0001"],
          ["OrderGID", "text", "Order GID"],
          ["OrderName", "text", "Order name"],
          ["LineItemGID", "text", "ORIGINAL line item GID"],
          ["SKU", "text", "SKU"],
          ["ProductVariant", "text", "Product / variant"],
          ["Quantity", "int", "Quantity coming back"],
          ["PhysicalReturnStatus", "text", "NOT_RETURNED / RETURN_REQUESTED / IN_TRANSIT / RECEIVED / INSPECTION_PENDING / CLOSED"],
          ["ReceivedDate", "date", "Date goods physically arrived"],
          ["Reason", "text", "Reason"],
          ["RelatedRefundGID", "text", "Refund GID if any"],
          ["ExchangeOrderName", "text", "Replacement order if exchange"],
          ["Notes", "text", "Notes"],
          ["CreatedAt", "datetime", "Entry timestamp"]
        ]},
        { "name": "RETURN_INSPECTIONS", "kind": "input", "purpose": "Inspection / restock decision per return. Only COMPLETE + approved rows affect COGS and stock.", "columns": [
          ["InspectionID", "text", "e.g. INS-0001 (unique - duplicates are ignored)"],
          ["ReturnID", "text", "Return"],
          ["InspectionDate", "date", "Inspection date (COGS reversal date)"],
          ["InspectionStatus", "text", "PENDING_INSPECTION / COMPLETE"],
          ["SellableQty", "int", "Accepted back into sellable stock"],
          ["DamagedQty", "int", "Damaged"],
          ["WriteOffQty", "int", "Written off"],
          ["InspectionNotes", "text", "Notes"],
          ["ApprovedBy", "text", "Required for COMPLETE"]
        ]},
        { "name": "INVENTORY_ADJUSTMENTS", "kind": "input", "purpose": "Approved stock adjustments (count differences, damage found in stock, write-offs of on-hand stock).", "columns": [
          ["AdjustmentID", "text", "e.g. ADJ-0001"],
          ["AdjustmentDate", "date", "Date"],
          ["SKU", "text", "SKU"],
          ["Bucket", "text", "SELLABLE / DAMAGED"],
          ["Quantity", "int", "Signed (+ in / - out)"],
          ["Reason", "text", "COUNT / DAMAGE / WRITE_OFF / OTHER"],
          ["ApprovedBy", "text", "Required"],
          ["Notes", "text", "Notes"]
        ]},
        { "name": "SALES", "kind": "output", "purpose": "Operational order-line view of REAL orders.", "columns": [
          ["OrderName", "text", "Order"],
          ["OrderDateLocal", "date", "Date"],
          ["CustomerGID", "text", "Customer"],
          ["CustomerName", "text", "Customer name"],
          ["City", "text", "City"],
          ["SKU", "text", "SKU"],
          ["ProductTitle", "text", "Product"],
          ["VariantTitle", "text", "Variant"],
          ["QtyOrdered", "int", "Qty"],
          ["UnitPrice", "number", "Unit price"],
          ["LineDiscount", "number", "Discount"],
          ["GrossSales", "number", "Gross"],
          ["QtyRefunded", "int", "Refunded qty (financial)"],
          ["RefundAllocated", "number", "Refund amount"],
          ["NetRevenue", "number", "Net revenue (line)"],
          ["FinancialStatus", "text", "Payment status"],
          ["FulfillmentStatus", "text", "Fulfillment"],
          ["LineItemGID", "text", "Key"]
        ]},
        { "name": "CUSTOMER_BASE", "kind": "output", "purpose": "Customer metrics from REAL-order net revenue.", "columns": [
          ["CustomerGID", "text", "Customer"],
          ["CustomerName", "text", "Name"],
          ["Phone", "text", "Phone"],
          ["Email", "text", "Email"],
          ["City", "text", "City"],
          ["FirstOrderDate", "date", "First REAL order"],
          ["LastOrderDate", "date", "Last REAL order"],
          ["TotalOrders", "int", "REAL non-cancelled orders"],
          ["TotalGrossSales", "number", "Gross"],
          ["TotalRefunds", "number", "Refunds incl. unallocated"],
          ["TotalNetRevenue", "number", "Net revenue"],
          ["AverageOrderValue", "number", "Net revenue / orders"],
          ["Segment", "text", "NEW / REPEAT / LOYAL / REFUNDED_ONLY"],
          ["RepeatCustomer", "bool", "2+ orders"]
        ]},
        { "name": "SALES_COSTED", "kind": "output", "purpose": "SALES_FACT (REAL lines) joined to the cost valid on the ORIGINAL sale date.", "columns": [
          ["LineItemGID", "text", "Key"],
          ["OrderGID", "text", "Order"],
          ["OrderName", "text", "Order name"],
          ["OrderDateLocal", "date", "Sale date"],
          ["OrderMonth", "text", "yyyy-MM"],
          ["SKU", "text", "SKU"],
          ["ProductTitle", "text", "Product"],
          ["QtyShipped", "int", "COGS quantity"],
          ["NetRevenue", "number", "Line net revenue"],
          ["EffectiveUnitCost", "number", "Unit cost valid on sale date (blank if missing - never zero-filled)"],
          ["CostRecordID", "text", "COST_MASTER row used"],
          ["CostStatus", "text", "OK / MISSING_SKU / MISSING_COST / NOT_SHIPPED"],
          ["COGS", "number", "QtyShipped x EffectiveUnitCost (blank if cost missing)"],
          ["SellableReturnedQty", "int", "Approved SELLABLE returns"],
          ["COGSReversal", "number", "SellableReturnedQty x original EffectiveUnitCost"],
          ["NetCOGS", "number", "COGS - COGSReversal"],
          ["GrossProfit", "number", "NetRevenue - NetCOGS (blank if cost missing)"]
        ]},
        { "name": "COGS_EVENTS", "kind": "output", "purpose": "COGS ledger with idempotent event IDs (sale COGS + sellable-return reversals).", "columns": [
          ["EventID", "text", "COGS-<line> / COGSREV-<inspection>"],
          ["EventType", "text", "COGS / COGS_REVERSAL"],
          ["LineItemGID", "text", "Original line"],
          ["OrderName", "text", "Order"],
          ["SKU", "text", "SKU"],
          ["EventDateLocal", "date", "Recognition date"],
          ["EventMonth", "text", "yyyy-MM"],
          ["Quantity", "int", "Quantity"],
          ["UnitCost", "number", "Original effective unit cost"],
          ["Amount", "number", "Signed COGS effect (+ cost / - reversal); blank if cost missing"],
          ["SourceID", "text", "Line or inspection id"],
          ["CostStatus", "text", "OK / MISSING_COST"]
        ]},
        { "name": "INVENTORY_MOVEMENTS", "kind": "output", "purpose": "Traceable stock ledger. SELLABLE, DAMAGED and WRITTEN_OFF buckets are separate.", "columns": [
          ["MovementID", "text", "Deterministic unique ID"],
          ["MovementDate", "date", "Date"],
          ["MovementMonth", "text", "yyyy-MM"],
          ["SKU", "text", "SKU"],
          ["MovementType", "text", "OPENING / PRODUCTION_RECEIPT / PURCHASE_RECEIPT / SALE / RETURN_SELLABLE / RETURN_DAMAGED / RETURN_WRITE_OFF / ADJUSTMENT"],
          ["Bucket", "text", "SELLABLE / DAMAGED / WRITTEN_OFF"],
          ["Quantity", "int", "Signed"],
          ["UnitCost", "number", "Cost per unit carried (0 for damaged/write-off returns whose COGS was kept)"],
          ["Value", "number", "Quantity x UnitCost (blank if cost missing)"],
          ["SourceTable", "text", "Origin table"],
          ["SourceID", "text", "Origin row"]
        ]},
        { "name": "INVENTORY", "kind": "output", "purpose": "Stock position per SKU from the movement ledger.", "columns": [
